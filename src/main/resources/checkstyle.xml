<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">

    <!-- ✅ LineLength TreeWalker altında ola bilməz, ona görə yuxarı səviyyəyə çıxardııq -->
    <module name="LineLength">
        <property name="max" value="120"/>
    </module>

    <module name="TreeWalker">

        <!-- ✅ Bu modul ancaq import `*` qadağası üçündür (TreeWalker-in içində ola bilər) -->
        <module name="AvoidStarImport"/>

        <!-- ✅ Kod indentasiyasını yoxlayır -->
        <module name="Indentation"/>

        <!-- ✅ Method naming qaydasını yoxlayır -->
        <module name="MethodName"/>

        <!-- ✅ Class adlarının naming standardını yoxlayır -->
        <module name="TypeName"/>

        <!-- Optionally, style checks -->
        <module name="MethodName"/>
        <module name="TypeName"/>
    </module>

</module>
